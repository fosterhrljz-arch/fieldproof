# Keep .env private and outside any served directory.
FIELDPROOF_BIND=127.0.0.1
FIELDPROOF_PORT=8740
FIELDPROOF_TIME_ZONE=America/Denver

# Required when staff connect from other devices. Use your own HTTPS origin.
# FIELDPROOF_ORIGIN=https://fieldproof.example.com

# Optional. The server creates a one-time code on first launch when this is unset.
# FIELDPROOF_SETUP_CODE=

# Optional absolute path to the SQLite database on persistent storage.
# FIELDPROOF_DB=/var/lib/fieldproof/fieldproof.sqlite
